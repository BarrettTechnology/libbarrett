# Copy to /etc/systemd/system/wamudpd.service
# sudo systemctl daemon-reload
# sudo systemctl enable wamudpd.service
# sudo systemctl start wamudpd.service

[Unit]
Description=WAM UDP Daemon Service
After=network.target 

[Service]
Type=simple
ExecStart=/usr/local/sbin/wamudpd
Restart=always

[Install]
WantedBy=multi-user.target
